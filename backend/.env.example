ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://quantumalpha:quantumalpha@localhost:5432/quantumalpha

# CORS - comma separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Market data provider: yfinance | alpha_vantage (future)
MARKET_DATA_PROVIDER=yfinance

# Risk-free rate used in Sharpe/Sortino calculations (annualized, e.g. 0.04 = 4%)
RISK_FREE_RATE=0.04

# Optional: FRED (Federal Reserve Economic Data) API key - free, instant signup at
# https://fredaccount.stlouisfed.org/apikeys. Unlocks real macro data (Treasury yield
# curve, unemployment, inflation) in the Contexto view. Leave blank to skip that section.
FRED_API_KEY=
